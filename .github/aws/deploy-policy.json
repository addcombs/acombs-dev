{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListUiBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::acombs-dev-ui-814787355274"
    },
    {
      "Sid": "WriteUiFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::acombs-dev-ui-814787355274/*"
    },
    {
      "Sid": "RefreshUiDistribution",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
      "Resource": "arn:aws:cloudfront::814787355274:distribution/E3AT42Y0KTXYMQ"
    },
    {
      "Sid": "UploadAndReadApiPackage",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::acombs-dev-deploy-814787355274/acombs-dev-api-lambda.zip"
    },
    {
      "Sid": "DeployApiFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode",
        "lambda:PublishVersion",
        "lambda:GetAlias",
        "lambda:UpdateAlias"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-2:814787355274:function:acombs-dev-api",
        "arn:aws:lambda:us-east-2:814787355274:function:acombs-dev-api:*"
      ]
    }
  ]
}
